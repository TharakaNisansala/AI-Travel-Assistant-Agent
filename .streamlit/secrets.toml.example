# EXAMPLE ONLY: placeholders, no real values. Safe to commit.
#
# How to use it (docs/DEPLOYMENT.md, step 4):
#   - Streamlit Community Cloud: paste these lines into the app's
#     "Advanced settings" > "Secrets" box and fill in your values there.
#   - Local test of the public mode: copy this file to .streamlit/secrets.toml
#     (git-ignored) and fill it in. Never commit that copy.
#
# Rules:
#   - Keep every line at the top level (no [sections]): Streamlit copies
#     top-level values into environment variables, which the app reads.
#   - Write every value as a quoted string ("1", not 1 or true). Streamlit
#     does not copy true/false into environment variables.
#   - An empty value ("") means "not set": a provider without its key and
#     model is skipped; an empty limit uses its default.
#   - Never set TRAVEL_DEV here: the public page ignores it anyway.

# --- Public mode (required) -------------------------------------------------
TRAVEL_PUBLIC = "1"

# --- AI providers: fill in at least one; more give fallbacks -----------------
# Order to try them in. Default: gemini,cloudflare,groq
LLM_FALLBACK_ORDER = "gemini,cloudflare,groq"

# Gemini: key from https://aistudio.google.com/ and a current Flash model ID.
GEMINI_API_KEY = ""
GEMINI_MODEL = ""

# Cloudflare Workers AI: an API token with Workers AI permission and your
# account ID (Cloudflare dashboard). Empty model = @cf/zai-org/glm-4.7-flash.
CLOUDFLARE_API_TOKEN = ""
CLOUDFLARE_ACCOUNT_ID = ""
CLOUDFLARE_MODEL = ""

# Groq: key from https://console.groq.com/keys and a model ID with tool use.
GROQ_API_KEY = ""
GROQ_MODEL = ""

# --- Usage limits (optional: empty = the default shown) ----------------------
TRAVEL_MAX_MESSAGES_PER_SESSION = ""   # default 15
TRAVEL_MAX_DAILY_LLM_CALLS = ""        # default 150, all visitors together
TRAVEL_MAX_CONCURRENT_REQUESTS = ""    # default 2
TRAVEL_MAX_MESSAGE_CHARS = ""          # default 1000
TRAVEL_MAX_HISTORY_TOKENS = ""         # default 8000
TRAVEL_THREAD_IDLE_MINUTES = ""        # default 120
