# Copy this file to .env and fill in the values. Never commit .env.

# Which provider runs the model: gemini (default), groq or cloudflare.
# Only the chosen provider's key and model need to be set.
LLM_PROVIDER=

# API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# A currently supported Gemini *Flash* model ID, as listed in Google AI Studio.
GEMINI_MODEL=

# API key from the Groq console: https://console.groq.com/keys
GROQ_API_KEY=

# A current Groq model ID that supports tool use, as listed in the Groq console.
GROQ_MODEL=

# Cloudflare Workers AI: an API token with Workers AI permission and your
# account ID, both from the Cloudflare dashboard.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: a Workers AI model that supports function calling.
# Empty means the default, @cf/zai-org/glm-4.7-flash.
CLOUDFLARE_MODEL=
